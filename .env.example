# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in the values below. Never put a real secret in THIS file —
# it's committed to git (see .gitignore's explicit exception for it);
# .env.local is not.

# MongoDB Atlas connection string. Use a dedicated dev/staging/prod database
# name per environment (see 07-roadmap-and-architecture.md, section 3).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=aaspaas"
MONGODB_DB_NAME=aaspaas_dev

# Cloudinary (place photo upload/resize/CDN). Required for POST
# /api/places/[id]/photos — without these set, that route throws.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signs the 15-minute access JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (Refresh tokens are opaque random strings, hashed at rest — see
# src/lib/auth/tokens.ts — so there's no JWT_REFRESH_SECRET to set.)
JWT_ACCESS_SECRET=

# Transactional email (Resend free tier). Without this set, verification
# emails are logged to the server console instead of sent — fine for local
# dev, see src/lib/email/sendVerificationEmail.ts.
EMAIL_FROM=
RESEND_API_KEY=

# Base URL used to build links in emails (verification links, etc).
APP_BASE_URL=http://localhost:3000
