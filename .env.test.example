# Copy this file to .env.test for running Playwright e2e tests locally:
#   cp .env.test.example .env.test
# Then fill in the values below. Never commit .env.test (see .gitignore).
#
# tests/e2e/global-setup.ts WIPES this database before every run — point it
# at a dedicated, disposable database, never aaspaas_dev/staging/prod. The
# setup script itself refuses to run unless MONGODB_DB_NAME ends in "_e2e",
# as a hard stop against a copy-paste mistake pointing this at a real db.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=aaspaas"
MONGODB_DB_NAME=aaspaas_e2e

# Same as .env.example — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Playwright drives real register/login forms, so verification emails are
# sent — leave RESEND_API_KEY unset and they log to the server console
# instead (see src/lib/email/sendVerificationEmail.ts). The 3 e2e flows
# don't rely on that link (see tests/e2e/helpers/db.ts's markEmailVerified),
# so this is fine to leave empty.
EMAIL_FROM=
RESEND_API_KEY=

APP_BASE_URL=http://localhost:3000

# Cloudinary isn't needed — photo upload isn't one of the 3 required e2e
# flows (07-roadmap-and-architecture.md §3's SDLC plan names only search,
# add-place, and report→moderation).
