# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example and .env.test.example are the deliberate
# exceptions: placeholder-only templates meant to be committed so new
# contributors know what to set (see README's "Getting started" and "End-to-
# end tests"). Never put a real value in either — .env* below still blocks
# every actual .env.local/.env/.env.test file.
.env*
!.env.example
!.env.test.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
